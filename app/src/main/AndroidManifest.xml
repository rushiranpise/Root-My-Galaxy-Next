<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Held by the boot gate while it waits out the settle floor and runs the install, so the device
      cannot drop back into suspend mid-run. Missing this is a hard crash, not a degraded run.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Needed to reach the device's own adbd on loopback and to discover its port.-->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      The type the boot services and the pairing service declare. It is what replaced `dataSync` on the
      three services below, which Android 15 refuses to start from a boot broadcast.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Declared but not granted by default: only a rooted device (or `adb install -g`) can grant it,
      and it is what allows wireless debugging to be turned on for a run. Without it the transport
      still works when the user has wireless debugging on already.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        KernelSU-Next's spoofed manager build rewrites its package to three random words, so no name
        in this list can cover it and the app has to look for one by what it carries instead. Needs
        this app to see packages it has not asked about by name; it is a sideloaded root tool, so
        nothing here is subject to a store's policy on it.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="me.weishu.kernelsu" />
        <!--
            KernelSU-Next's manager. The spoofed build of it renames its package to three random
            words, so a fixed list cannot cover that one - see KernelSuManager, which finds it by the
            daemon it carries instead.
        -->
        <package android:name="com.rifsxd.ksunext" />
        <!--
            ReSukiSU's manager, which publishes this one name and does not rewrite it per build. It is
            still validated inside the kernel by its signature, so a repacked copy is a separate
            concern from finding it - see KernelSuManager.
        -->
        <package android:name="com.resukisu.resukisu" />
        <package android:name="moe.shizuku.manager" />
    </queries>

    <application
        android:name=".RootMyGalaxyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.S25URoot">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!--
          The three services the boot broadcast starts, and the one attribute they share: `specialUse`
          rather than `dataSync`.

          An app that targets Android 15 may not launch a `dataSync` foreground service from a
          BOOT_COMPLETED receiver: the system refuses the start, the service never runs, and what the user
          is left with is a phone that came back unrooted with nothing anywhere saying why. All three of
          these are started only that way, and none of them is a data sync - one waits out the reboot and
          runs the saved installation, one brings Shizuku back, and one asks the stage-two helper to load
          KernelSU again. The remaining types either describe something else or cap the service
          (`shortService` is a few minutes; these waits are longer), so `specialUse` is the honest one. The
          subtype beside each is the justification Play asks for, and is read by nothing at runtime.
        -->
        <service
            android:name=".AutoRootService"
            android:exported="false"
            android:process=":autoroot_gate"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="waits for the device to settle after a reboot, then runs the saved root installation" />
        </service>
        <service
            android:name=".ShizukuBootService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="starts Shizuku's server after a reboot, by root, wireless debugging or the start token" />
        </service>
        <!--
          The reroot gate, in the same process as the install gate: both are started by the same boot
          broadcast, both wait, and a process that outlives the app's own is what a boot path needs.
        -->
        <service
            android:name=".DfrBootService"
            android:exported="false"
            android:process=":autoroot_gate"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="starts the stage-two helper after a reboot so KernelSU is loaded into it again" />
        </service>
        <receiver
            android:name=".AutoRootBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".AutoRootActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".DfrBootActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".RunActionReceiver"
            android:exported="false" />
        <service
            android:name=".AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pairs with the device's own wireless debugging" />
        </service>
        <receiver
            android:name=".WirelessAdbCleanupReceiver"
            android:exported="false" />
        <receiver
            android:name=".OpenDeveloperOptionsReceiver"
            android:exported="false" />
        <activity
            android:name=".AdbPairingSetupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <activity
            android:name=".InstallActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- What a long press on the app icon offers, without the app being opened first. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
